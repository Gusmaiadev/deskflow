# ---------------------------------------------------------------
# DeskFlow API - variáveis de ambiente
# Copie este arquivo para .env e troque os valores.
# O .env NUNCA vai para o Git.
# ---------------------------------------------------------------

# Porta em que a API escuta
PORT=3333

# PostgreSQL local (lido pelo docker compose ao criar o banco)
POSTGRES_USER=deskflow
POSTGRES_PASSWORD=troque-por-uma-senha-gerada
POSTGRES_DB=deskflow
POSTGRES_PORT=5433

# Conexão usada pela API e pelo Prisma rodando no WSL.
# A senha precisa ser a mesma de POSTGRES_PASSWORD.
DATABASE_URL=postgresql://deskflow:troque-por-uma-senha-gerada@127.0.0.1:5433/deskflow

# Senha dos usuários de exemplo criados pelo seed
SEED_USER_PASSWORD=troque-por-outra-senha-gerada

# Autenticação
# Segredo que assina os tokens de acesso (gere com: openssl rand -hex 32)
JWT_ACCESS_SECRET=troque-por-um-segredo-de-64-caracteres-gerado
# Validade do token de acesso, em minutos
JWT_ACCESS_TTL_MINUTES=15
# Validade da sessão (refresh token), em dias
REFRESH_TOKEN_TTL_DAYS=7

# Endereços do frontend autorizados a chamar a API (separe vários por vírgula)
CORS_ORIGINS=http://localhost:5173

# Contas de demonstração: não trocam a senha nem são alteradas pelo admin (separe por vírgula; vazio = nenhuma)
DEMO_ACCOUNT_EMAILS=
# Categorias da demonstração, que o admin não pode alterar (separe por vírgula; vazio = nenhuma)
DEMO_CATEGORY_NAMES=

# Banco usado pelos testes automatizados (os testes APAGAM os dados dele)
TEST_DATABASE_URL=postgresql://deskflow:troque-por-uma-senha-gerada@127.0.0.1:5433/deskflow_test
