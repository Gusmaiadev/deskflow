# ---------------------------------------------------------------
# DeskFlow API - variáveis de ambiente
# Copie este arquivo para .env e troque os valores.
# O .env NUNCA vai para o Git.
# ---------------------------------------------------------------

# Porta em que a API escuta
PORT=3333

# PostgreSQL local (lido pelo docker compose ao criar o banco)
POSTGRES_USER=deskflow
POSTGRES_PASSWORD=troque-por-uma-senha-gerada
POSTGRES_DB=deskflow
POSTGRES_PORT=5433

# Conexão usada pela API e pelo Prisma rodando no WSL.
# A senha precisa ser a mesma de POSTGRES_PASSWORD.
DATABASE_URL=postgresql://deskflow:troque-por-uma-senha-gerada@127.0.0.1:5433/deskflow

# Senha dos usuários de exemplo criados pelo seed
SEED_USER_PASSWORD=troque-por-outra-senha-gerada
