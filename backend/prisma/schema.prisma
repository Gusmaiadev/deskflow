generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  REQUESTER
  AGENT
  ADMIN

  @@map("user_role")
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_REQUESTER
  RESOLVED
  CLOSED

  @@map("ticket_status")
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT

  @@map("ticket_priority")
}

model User {
  id           String   @id @default(uuid(7)) @db.Uuid
  name         String   @db.VarChar(100)
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  role         Role     @default(REQUESTER)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  requestedTickets Ticket[]        @relation("TicketRequester")
  assignedTickets  Ticket[]        @relation("TicketAssignee")
  comments         TicketComment[]
  refreshTokens    RefreshToken[]

  @@map("users")
}

model Category {
  id          String   @id @default(uuid(7)) @db.Uuid
  name        String   @unique @db.VarChar(60)
  description String?  @db.VarChar(255)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tickets Ticket[]

  @@map("categories")
}

model Ticket {
  id           String         @id @default(uuid(7)) @db.Uuid
  number       Int            @unique @default(autoincrement())
  title        String         @db.VarChar(150)
  description  String         @db.Text
  status       TicketStatus   @default(OPEN)
  priority     TicketPriority @default(MEDIUM)
  dueAt        DateTime       @map("due_at") @db.Timestamptz(3)
  waitingSince DateTime?      @map("waiting_since") @db.Timestamptz(3)
  resolvedAt   DateTime?      @map("resolved_at") @db.Timestamptz(3)
  closedAt     DateTime?      @map("closed_at") @db.Timestamptz(3)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  requesterId String  @map("requester_id") @db.Uuid
  assigneeId  String? @map("assignee_id") @db.Uuid
  categoryId  String  @map("category_id") @db.Uuid

  requester User            @relation("TicketRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  assignee  User?           @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  category  Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  comments  TicketComment[]

  @@index([requesterId])
  @@index([assigneeId])
  @@index([categoryId])
  @@index([status, dueAt])
  @@index([createdAt])
  @@map("tickets")
}

model TicketComment {
  id         String   @id @default(uuid(7)) @db.Uuid
  body       String   @db.Text
  isInternal Boolean  @default(false) @map("is_internal")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  ticketId String @map("ticket_id") @db.Uuid
  authorId String @map("author_id") @db.Uuid

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([ticketId, createdAt])
  @@index([authorId])
  @@map("ticket_comments")
}

model RefreshToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  familyId  String    @map("family_id") @db.Uuid
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}
