# ---------------------------------------------------------------
# DeskFlow - manutenção do banco de PRODUÇÃO (seed e reset da demo)
# Modelo do arquivo .env.tools, que fica na EC2 para o reset da meia-noite.
# A URL do administrador (MIGRATION_DATABASE_URL) NÃO fica aqui: as migrations
# a recebem na hora, montada a partir do .env.db (veja o cabeçalho do
# docker-compose.prod.yml). O seed e o reset usam a DATABASE_URL do .env.production.
# ---------------------------------------------------------------

# Senha dos usuários de exemplo criados pelo seed: é a senha pública da demo
# (publicada no README), então não pode ser igual a nenhuma senha sua
SEED_USER_PASSWORD=troque-por-outra-senha-gerada
