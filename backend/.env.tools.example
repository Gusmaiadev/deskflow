# ---------------------------------------------------------------
# DeskFlow - manutenção do banco de PRODUÇÃO (migrations, seed e reset da demo)
# Modelo do arquivo .env.tools, que fica na EC2 para o reset da meia-noite.
# A linha MIGRATION_DATABASE_URL, com a senha do administrador da RDS,
# entra só quando for aplicar migrations e sai logo depois.
# ---------------------------------------------------------------

# Conexão das migrations, com o usuário administrador da RDS.
# sslmode=require: o motor de migrations do Prisma exige TLS, mas
# não aceita o modo verify-full (veja o guia do Dia 5).
MIGRATION_DATABASE_URL=postgresql://deskflow_admin:troque-pela-senha-do-admin@SEU-ENDPOINT.us-east-1.rds.amazonaws.com:5432/deskflow?sslmode=require

# Senha dos usuários de exemplo criados pelo seed: é a senha pública da demo
# (publicada no README), então não pode ser igual a nenhuma senha sua
SEED_USER_PASSWORD=troque-por-outra-senha-gerada
