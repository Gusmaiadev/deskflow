# ---------------------------------------------------------------
# DeskFlow API - PRODUÇÃO (EC2)
# Modelo do arquivo .env.production, que é criado SÓ na EC2.
# Este modelo vai para o Git; o .env.production, nunca.
# ---------------------------------------------------------------

# Conexão da API com a RDS, usando o usuário de permissões mínimas.
# sslmode=verify-full: criptografa E confere que o servidor é a sua RDS,
# usando os certificados da AWS que o Dockerfile coloca em /app/certs.
DATABASE_URL=postgresql://deskflow_app:troque-pela-senha-do-deskflow-app@SEU-ENDPOINT.us-east-1.rds.amazonaws.com:5432/deskflow?sslmode=verify-full&sslrootcert=/app/certs/rds-global-bundle.pem

# Autenticação (gere um segredo NOVO para produção: openssl rand -hex 32)
JWT_ACCESS_SECRET=troque-por-um-segredo-de-64-caracteres-gerado
JWT_ACCESS_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# Endereços do frontend autorizados a chamar a API (separe vários por vírgula)
CORS_ORIGINS=https://SEU-ID.cloudfront.net

# Quantos proxies confiáveis ficam na frente da API (CloudFront = 1)
TRUST_PROXY_HOPS=1

# Segredo que o CloudFront envia no header X-Origin-Verify (openssl rand -hex 32)
ORIGIN_SECRET=troque-por-um-segredo-de-64-caracteres-gerado

# Contas de demonstração (os usuários do seed, com a senha publicada no README):
# a API não deixa trocar a senha delas nem alterá-las pela administração
DEMO_ACCOUNT_EMAILS=admin@deskflow.example,rafael@deskflow.example,juliana@deskflow.example,ana@deskflow.example,bruno@deskflow.example
