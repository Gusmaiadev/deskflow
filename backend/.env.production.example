# ---------------------------------------------------------------
# DeskFlow API - PRODUÇÃO (EC2)
# Modelo do arquivo .env.production, que é criado SÓ na EC2.
# Este modelo vai para o Git; o .env.production, nunca.
# ---------------------------------------------------------------

# Conexão da API com o PostgreSQL do serviço db (docker-compose.prod.yml), usando o
# usuário de permissões mínimas. Senha: openssl rand -hex 24 (só letras e números).
# Sem sslmode de propósito: o banco não publica porta, e a conexão fica na rede
# interna do Docker, sem sair da EC2.
DATABASE_URL=postgresql://deskflow_app:troque-pela-senha-do-deskflow-app@db:5432/deskflow

# Autenticação (gere um segredo NOVO para produção: openssl rand -hex 32)
JWT_ACCESS_SECRET=troque-por-um-segredo-de-64-caracteres-gerado
JWT_ACCESS_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# Endereços do frontend autorizados a chamar a API (separe vários por vírgula)
CORS_ORIGINS=https://SEU-PROJETO.vercel.app

# Quantos proxies confiáveis ficam na frente da API (Vercel + CloudFront = 2)
TRUST_PROXY_HOPS=2

# Segredo que a Vercel envia no header X-Origin-Verify (openssl rand -hex 32)
ORIGIN_SECRET=troque-por-um-segredo-de-64-caracteres-gerado

# Contas de demonstração (os usuários do seed, com a senha publicada no README):
# a API não deixa trocar a senha delas nem alterá-las pela administração
DEMO_ACCOUNT_EMAILS=admin@deskflow.example,rafael@deskflow.example,juliana@deskflow.example,ana@deskflow.example,bruno@deskflow.example
# Categorias do seed: o admin da demo não as desativa nem altera
DEMO_CATEGORY_NAMES=Acesso e senhas,Hardware,Software,Rede e internet,Manutenção predial
