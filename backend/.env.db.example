# ---------------------------------------------------------------
# DeskFlow - PostgreSQL de PRODUÇÃO (serviço db do docker-compose.prod.yml)
# Modelo do arquivo .env.db, que é criado SÓ na EC2, com permissão 600.
# Este modelo vai para o Git; o .env.db, nunca. Só o serviço db lê este arquivo.
# ---------------------------------------------------------------

# Administrador e dono do banco, que roda as migrations.
# Os nomes precisam ser estes: o deploy/app-role.sql os usa.
POSTGRES_USER=deskflow_admin
POSTGRES_DB=deskflow

# Senha do administrador (openssl rand -hex 24: só letras e números, para não
# quebrar a URL das migrations). A imagem só a usa na PRIMEIRA inicialização,
# com o volume vazio; trocar este valor depois não muda a senha no banco.
POSTGRES_PASSWORD=troque-por-uma-senha-gerada
